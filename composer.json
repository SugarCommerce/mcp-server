{
  "name": "sugarcommerce/mcp-server",
  "version": "1.4.0",
  "description": "A Model Context Protocol server for plain PHP. Implements the 2026-07-28 revision, and serves 2025-11-25 and 2025-06-18 clients: stateless per-request negotiation, JSON-RPC 2.0 over Streamable HTTP, typed tools with JSON Schema validation, and scope-based authorization. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/mcp-server",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["mcp", "model-context-protocol", "json-rpc", "llm", "tools", "ai"],
  "require": { "php": ">=8.5", "ext-json": "*" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Mcp\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Mcp\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/mcp-server/issues", "source": "https://github.com/sugarcommerce/mcp-server" }
}
